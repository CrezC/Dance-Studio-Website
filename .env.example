DATABASE_URL="postgresql://user:password@localhost:5432/dance_studio?schema=public"

# Shared admin password for the /admin area (single-admin MVP — no user
# accounts yet). Pick a real value in your own .env; this is just a sample.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie. Generate one with:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-too"
